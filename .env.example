# ============================================================
# IndicVoiceRAG — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# NEVER commit the .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Server Configuration (Render dynamically assigns PORT)
# ----------------------------------------------------------
PORT=8000
RELOAD=false
PYTHONUNBUFFERED=1

# ----------------------------------------------------------
# Speech-to-Text (Sarvam AI)
# Get your key at: https://dashboard.sarvam.ai
# ----------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4

# ----------------------------------------------------------
# Vector Database & Fast Store
# ----------------------------------------------------------
QDRANT_STORAGE_PATH=./data/qdrant_db
BM25_STORAGE_PATH=./data/bm25_index.pkl

# ----------------------------------------------------------
# LLM Generation Provider (Optional)
# Leave blank to use grounded extractive answers.
# ----------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ----------------------------------------------------------
# Dataset & Indexing Mode
# INDEX_MODE="real" uses persistent MSMARCO-XI index
# ----------------------------------------------------------
INDEX_MODE=real
SAMPLE_MODE=false
DEMO_MODE=true

# ----------------------------------------------------------
# CORS (comma-separated allowed origins for production)
# Example: CORS_ORIGINS=https://myfrontend.onrender.com,http://localhost:3000
# ----------------------------------------------------------
CORS_ORIGINS=
