# ============================================================
# IndicVoiceRAG — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# NEVER commit the .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Speech-to-Text (Sarvam AI)
# Get your key at: https://dashboard.sarvam.ai
# ----------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4

# ----------------------------------------------------------
# Vector Database (Qdrant)
# Use ":memory:" for ephemeral local dev, or a full URL for
# persistent storage (e.g. "http://localhost:6333" or a
# cloud Qdrant URL).
# ----------------------------------------------------------
QDRANT_URL=:memory:
QDRANT_API_KEY=

# ----------------------------------------------------------
# LLM Generation Provider
# Supports OpenAI, Groq, or any OpenAI-compatible endpoint.
# Leave blank to use extractive (non-generative) answers.
# ----------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ----------------------------------------------------------
# Embedding & Reranker Models (downloaded automatically)
# ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ----------------------------------------------------------
# Dataset & Index Mode
# INDEX_MODE: "real" = stream ai4bharat/MSMARCO-XI on startup
#             "sample" = load a small in-memory sample (fast dev)
# SAMPLE_MODE: true/false (legacy alias for sample index)
# ----------------------------------------------------------
INDEX_MODE=sample
SAMPLE_MODE=true
SAMPLE_SIZE=1000
DEMO_MODE=true
FAST_PATH_THRESHOLD=0.85

# ----------------------------------------------------------
# Real MSMARCO-XI Dataset Ingestion (used when INDEX_MODE=real)
# ----------------------------------------------------------
MSMARCO_DATASET=ai4bharat/MSMARCO-XI
MSMARCO_SPLIT=train
MSMARCO_LANGUAGES=en,hi,te
MSMARCO_MAX_RECORDS=1000
MSMARCO_BATCH_SIZE=64
MSMARCO_STREAMING=true

# ----------------------------------------------------------
# Persistent Storage Paths
# ----------------------------------------------------------
QDRANT_STORAGE_PATH=./data/qdrant_db
BM25_STORAGE_PATH=./data/bm25_index.pkl

# ----------------------------------------------------------
# CORS (comma-separated allowed origins for production)
# Example: CORS_ORIGINS=https://myapp.com,https://staging.myapp.com
# Leave blank to default to localhost development origins.
# ----------------------------------------------------------
CORS_ORIGINS=

# ----------------------------------------------------------
# Frontend
# ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
