# Frontend environment variables — copy to .env.local for local development
# NEVER commit .env.local to version control (it is gitignored by Next.js)

# Backend API URL (update for production deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Voice pipeline debug logging
# Set to "true" to enable [VOICE DEBUG], [WS], [VAD] logs in browser console
# Leave "false" (default) for production — logs are suppressed
NEXT_PUBLIC_DEBUG_VOICE=false
